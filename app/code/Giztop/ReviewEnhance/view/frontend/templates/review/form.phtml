 * @var \Magento\Review\Block\Form $block
 * @var \Magento\Framework\Escaper $escaper
 */

/** @var \Magento\Framework\View\Element\ButtonLockManager|null $buttonLockManager */
$buttonLockManager = $block->getData('button_lock_manager');
if (!$buttonLockManager && class_exists(\Magento\Framework\View\Element\ButtonLockManager::class)) {
    $objectManager = \Magento\Framework\App\ObjectManager::getInstance();
    $buttonLockManager = $objectManager->get(\Magento\Framework\View\Element\ButtonLockManager::class);

    $block->setButtonLockManager($buttonLockManager);
}
?>
<div class="block review-add">
