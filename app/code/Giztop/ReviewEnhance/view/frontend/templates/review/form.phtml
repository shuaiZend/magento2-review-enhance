                                        id="<?= $escaper->escapeHtmlAttr(str_replace(' ', '_', $_rating->getRatingCode())) ?>_<?= $escaper->escapeHtmlAttr($_option->getValue()) ?>_label">
                                        <span><?= $escaper->escapeHtml(__('%1 %2', $iterator, $iterator > 1 ? __('stars') : __('star'))) ?></span>
                                    </label>
                                <?php $iterator++; ?>
                                <?php endforeach; ?>
                                </div>
                            </div>
                        <?php endforeach; ?>
                    </div>
