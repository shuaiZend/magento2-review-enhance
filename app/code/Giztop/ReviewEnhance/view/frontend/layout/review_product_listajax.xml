<?xml version="1.0"?>
<!--
  Giztop_ReviewEnhance: AJAX list (pagination) must keep the chat-bubble template.
  Do NOT override product.review.form here.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Giztop_ReviewEnhance::css/review-chat.css"/>
    </head>
    <body>
        <referenceBlock name="product.info.product_additional_data">
            <arguments>
                <argument name="giztop_vm" xsi:type="object">Giztop\ReviewEnhance\ViewModel\ReviewView</argument>
            </arguments>
            <action method="setTemplate">
                <argument name="template" xsi:type="string">Giztop_ReviewEnhance::review/list.phtml</argument>
            </action>
        </referenceBlock>
    </body>
</page>
